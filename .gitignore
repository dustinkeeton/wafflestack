node_modules/
.DS_Store

# Lock-only (Posture 2b, #777): the .claude/ render is gitignored; commit the lock. Re-render after
# a pull or stacks/** edit; .github/ and .claude/settings.json stay tracked. `!` re-includes an ejected item.
/.claude/skills/*
/.claude/agents/*
/.claude/workflows/*
.claude/worktrees/
.codex/
.agents/
# waffle-label-hook.yml stays untracked — committing it would arm a live label→harness
# dispatch on this repo, which is not wanted here. Hooks this repo leaves off (see `eject:` in
# .waffle/waffle.yaml) are EJECTED, not gitignored — `render` never pours them, so there is
# nothing to ignore. doctor runs with --allow-missing so this absent render doesn't fail CI.
.github/workflows/waffle-label-hook.yml
.waffle/waffle.local.yaml
# …and the local lock it implies (#317): when a contributor's overlay actually feeds their render,
# `render` records THEIR hashes here, leaving .waffle/waffle.lock.json canonical (committed inputs
# only) and therefore identical for everyone. Machine-specific, exactly like the overlay — never
# commit it. Absent entirely on a machine with no overlay.
.waffle/waffle.local.lock.json
# Generated .waffle/ overview docs (cheat sheet + team intro, Markdown + branded HTML).
# Consumers commit these; here they are generated-only. doctor treats the class as
# presence-optional (#528), so unlike the label-hook workflow above they need no flag.
.waffle/CHEATSHEET.md
.waffle/TEAM.md
.waffle/cheatsheet.html
.waffle/team.html
# …and the per-agent avatar files + their Gravatar registration manifest (#157).
.waffle/AVATARS.md
.waffle/avatars/
# …and the config-key catalog (#703).
.waffle/waffle.reference.yaml

# Files the Claude Code engine lays into a mod's source dir when a toolkit developer loads it from
# disk (`claude --plugin-dir` / `claude plugin test`). Per machine, never shipped (#562, #564).
stacks/*/mods/*/tsconfig.json
stacks/*/mods/*/.claude-plugin/types/

# Obsidian
.obsidian/
